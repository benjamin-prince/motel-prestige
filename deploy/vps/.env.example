# Domain pointing to this VPS (A record) — Caddy gets the TLS certificate.
PMS_DOMAIN=pms.example.com

# Strong database password — also used by the motel's sync script.
DB_PASSWORD=change-me-strong

# Random JWT secret (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-random

# Motel's timezone.
TZ=America/New_York
